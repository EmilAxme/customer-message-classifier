#!/bin/bash
# Двойной клик по этому файлу запускает приложение в браузере.
# (Если macOS ругается «неизвестный разработчик» — правый клик → «Открыть».)

cd "$(dirname "$0")" || exit 1

echo "==============================================="
echo "  Классификатор обращений — запуск"
echo "==============================================="

# Первый запуск: создаём окружение и ставим зависимости
if [ ! -d .venv ]; then
  echo "Первый запуск: устанавливаю компоненты (1-2 минуты)…"
  python3 -m venv .venv || { echo "Не найден Python 3. Установите его с https://python.org"; exit 1; }
  ./.venv/bin/pip install --quiet --upgrade pip
  ./.venv/bin/pip install --quiet -r requirements.txt
fi

echo "Открываю приложение в браузере… (для остановки закройте это окно)"
exec ./.venv/bin/streamlit run app.py
